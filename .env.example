# Copy to your shell environment (this app does not load .env files itself), e.g.
#   export JWT_SECRET="$(node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")"

# Secret used to sign login tokens. If unset, a random one is generated at
# startup and all logins are invalidated whenever the server restarts.
JWT_SECRET=

# OAuth 2.0 Web client ID for "Sign in with Google" (optional).
# Also replace the placeholder in index.html's google.accounts.id.initialize call.
GOOGLE_CLIENT_ID=

# Port to listen on (default 3000).
PORT=3000
